# 3. Calculate effect sizes (log Odds Ratio)
res_data <- escalc(measure="OR", ai=case_C, bi=case_A, ci=control_C, di=control_A, data=data_rs699947)

# 4. Perform Random-Effects Meta-Analysis (Method: REML)
model <- rma(yi, vi, data=res_data, method="REML")

# 5. View the statistical summary
# Check the 'Estimated Result' for the Pooled OR and 'I^2' for heterogeneity
print(summary(model))

# 6. Generate the Forest Plot for your presentation
forest(model, slab=res_data$author, header=TRUE, xlab="Odds Ratio (95% CI)",
       atransf=exp, digits=2, main="VEGFA rs699947 and ACL Injury Risk")



