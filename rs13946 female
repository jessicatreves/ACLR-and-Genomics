# 1. Load the metafor package
if(!require(metafor)) install.packages("metafor")
library(metafor)

# 2. Input your extracted allele counts for 13946 (C vs T)
# ai/bi = Case Allele C/T counts; ci/di = Control Allele C/T counts
data_rs13946 <- data.frame(
  author = c(Posthumus et al. (2009), Rodas et al. (2022), Sivertsen et al. (2019)),
  case_C = c(22, 6, 53),
  case_T = c(54, 8, 185),
  control_C = c(47, 4, 380),
  control_T = c(117, 30, 1098)
)

# 3. Calculate effect sizes (log Odds Ratio)
res_data <- escalc(measure="OR", ai=case_C, bi=case_T, ci=control_C, di=control_T, data=data_rs13946)

# 4. Perform Random-Effects Meta-Analysis (Method: REML)
model <- rma(yi, vi, data=res_data, method="REML")

# 5. View the statistical summary
# Check the 'Estimated Result' for the Pooled OR and 'I^2' for heterogeneity
print(summary(model))

# 6. Generate the Forest Plot for your presentation
forest(model, slab=res_data$author, header=TRUE, xlab="Odds Ratio (95% CI)",
       atransf=exp, digits=2, main="COL5A1 13946 and ACL Injury Risk")
